{
  "name": "eyeviz",
  "version": "0.1.0",
  "description": "React/Next.js component to render screen recordings with gaze fixations and interest area overlays.",
  "license": "MIT",
  "author": "",
  "homepage": "https://www.npmjs.com/package/eyeviz",
  "repository": {
    "type": "git",
    "url": ""
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=17 || >=18",
    "react-dom": ">=17 || >=18"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "nextjs",
    "video",
    "eyetracking",
    "gaze",
    "fixations",
    "interest-areas",
    "overlay",
    "visualization"
  ]
}

